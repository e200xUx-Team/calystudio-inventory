# ─────────────────────────────────────────────────────────────
# The ePlane Co. — Clay Studio Dashboard
# Set ALL of these in Vercel → Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# JWT signing secret — REQUIRED
JWT_SECRET=change-this-to-a-long-random-secret

# Admin accounts seeded on first run
ADMIN_EMAIL_1=rahul.sp@eplane.ai
ADMIN_NAME_1=Rahul Sakthevel
ADMIN_PASS_1=your-secure-password

ADMIN_EMAIL_2=rajan.sunjay@eplane.ai
ADMIN_NAME_2=Rajan Sunjay
ADMIN_PASS_2=your-secure-password

# Gmail SMTP for OTP and notification emails — REQUIRED for email features
# Use a Gmail account dedicated to this app
# App Password setup: Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASS=xxxx-xxxx-xxxx-xxxx

NODE_ENV=production
